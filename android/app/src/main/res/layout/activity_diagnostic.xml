<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12121e">

    <!-- Fixed Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:paddingBottom="8dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_pravaah_logo"
            android:contentDescription="Pravaah Logo"
            android:layout_marginEnd="10dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRAVAAH"
                android:textColor="#00ff88"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HYBRID MULTI-PATH DIAGNOSTIC NODE"
                android:textColor="#8892b0"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Diagnostic Surface -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Node Status Card -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1e1e2f"
                android:padding="8dp"
                android:text="Status: STOPPED&#10;PeerId: -&#10;TCP Port: - | BT: -"
                android:textColor="#e0e0e0"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <!-- Multi-Path Topology Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- LIVE NETWORK TOPOLOGY --"
                android:textColor="#00e5ff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="6dp"
                android:paddingBottom="2dp" />
            <TextView
                android:id="@+id/tvMultiPathTopology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1a2238"
                android:padding="6dp"
                android:text="No connected peer paths."
                android:textColor="#64ffda"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- Lifecycle Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="START"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:textSize="11sp"
                    android:enabled="false" />
                <Button
                    android:id="@+id/btnDiscover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISCOVER"
                    android:textSize="11sp"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Hybrid Connect & Failover Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnConnectTcp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONNECT TCP"
                    android:textSize="10sp"
                    android:enabled="false" />
                <Button
                    android:id="@+id/btnConnectBt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONNECT BT"
                    android:textSize="10sp"
                    android:enabled="false" />
                <Button
                    android:id="@+id/btnSimulateDrop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DROP"
                    android:textSize="10sp"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Message Input & Send -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">
                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:hint="Type payload message..."
                    android:textColor="#ffffff"
                    android:textColorHint="#888888"
                    android:textSize="12sp"
                    android:enabled="false" />
                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SEND"
                    android:textSize="11sp"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Event Logging Feed -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- REAL-TIME EVENT STREAM --"
                android:textColor="#00ff88"
                android:textSize="11sp"
                android:paddingTop="6dp" />
            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#090910"
                android:padding="6dp"
                android:textColor="#bbbbbb"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:minHeight="120dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>