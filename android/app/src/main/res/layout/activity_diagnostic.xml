<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12121e">

    <!-- Fixed Persistent Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:paddingBottom="6dp"
        android:background="#1a1a2e">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_pravaah_logo"
            android:contentDescription="Pravaah Logo"
            android:layout_marginEnd="10dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRAVAAH"
                android:textColor="#00ff88"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSISTENT MULTI-PATH COCKPIT"
                android:textColor="#8892b0"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable World Surface -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Local Node Status Monospace Bar -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1e1e2f"
                android:padding="8dp"
                android:text="Status: STOPPED | PeerId: - | TCP: - | BT: -"
                android:textColor="#e0e0e0"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp" />

            <!-- PEER CONTEXT CARD (A.D3 Section 8) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- ACTIVE PEER CONTEXT --"
                android:textColor="#00e5ff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvPeerContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#162238"
                android:padding="8dp"
                android:text="No peer selected. Discover or connect to a node to begin."
                android:textColor="#64ffda"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- CONVERSATION / HUMAN MESSAGING SURFACE (A.D3 Section 10) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- CONVERSATION --"
                android:textColor="#00ff88"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvConversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="#1a2238"
                android:padding="8dp"
                android:text="No messages yet."
                android:textColor="#80cbc4"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <!-- Message Input & Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">
                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Type message..."
                    android:textColorHint="#556677"
                    android:textColor="#ffffff"
                    android:background="#1e1e2f"
                    android:padding="8dp"
                    android:textSize="13sp"
                    android:singleLine="true" />
                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEND"
                    android:backgroundTint="#00c853"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Technical Disclosure Section: Network Controls -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- NETWORK OPERATIONS --"
                android:textColor="#ffb74d"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="10dp"
                android:paddingBottom="2dp" />

            <!-- Lifecycle Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="START"
                    android:backgroundTint="#00c853"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:backgroundTint="#d50000"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
                <Button
                    android:id="@+id/btnDiscover"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="DISCOVER"
                    android:backgroundTint="#0091ea"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Multi-Path Connect Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">
                <Button
                    android:id="@+id/btnConnectTcp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONNECT TCP"
                    android:backgroundTint="#00b0ff"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/btnConnectBt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONNECT BT"
                    android:backgroundTint="#aa00ff"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
                <Button
                    android:id="@+id/btnSimulateDrop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:text="DROP PATH"
                    android:backgroundTint="#ff6d00"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- LIVE NETWORK TOPOLOGY (Preserved Safety Net) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-- LIVE MULTI-PATH TOPOLOGY --"
                android:textColor="#00e5ff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvMultiPathTopology"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#162238"
                android:padding="6dp"
                android:text="No connected peer paths."
                android:textColor="#64ffda"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- LIVE WIRE FORENSIC STREAM (A.D3-P1 Bounded Viewport) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="-- LIVE WIRE FORENSIC STREAM --"
                    android:textColor="#ffab00"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvFollowBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="↓ NEW EVENTS"
                    android:textColor="#00ff88"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#1e3a29"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:visibility="gone" />
            </RelativeLayout>

            <!-- Bounded Dedicated Scroll Container (150dp fixed viewport height) -->
            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#1a1a2e"
                android:padding="6dp"
                android:fillViewport="true"
                android:layout_marginBottom="12dp">
                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#a8b2d1"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="System initializing...\n" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>